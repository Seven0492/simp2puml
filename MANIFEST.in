include README.md LICENSE main.py
include requirements-dev.txt
recursive-include tests *.py
include docs/simp2puml.1
recursive-include docs *.md
prune docs/images
prune site
recursive-include packaging *
include tools/build-native.py
include tools/build-icons.py
include simp2puml-windows.cmd simp2puml-macos.command simp2puml-linux.sh .gitattributes
recursive-include launchers *.sh *.ps1 *.pyw
recursive-include src/simp2puml/assets *.png *.ico
include examples/minimal.puml
exclude Monopoly*
exclude Classdiagram1.svg
prune examples/validation
prune .venv
prune .pytest_cache
prune .build-check
prune .man-check
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.egg-info
